# Copy to .env in this directory, then fill in your provider settings.
OPENAI_API_KEY=
CHATBI_MODEL=
# Optional OpenAI-compatible endpoint (usually ends with /v1).
# OPENAI_BASE_URL=https://your-provider.example/v1

# The four-domain workflow is the only orchestration entry point.
CHATBI_WORKFLOW_MODE=four_domain
# Separate Qwen embedding credentials; required only for vector search/indexing.
QWEN_EMBEDDING_API_KEY=
# Use the OpenAI-compatible endpoint for your Model Studio workspace and region.
QWEN_EMBEDDING_BASE_URL=
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIMENSIONS=1024

# Optional composed configuration. Leave commented to use the generated demo.
# CONFIG_FILE=example/deployment/config.yaml
# Use an absolute SQLAlchemy URI for file-based databases.
# CHATBI_DATABASE_URI=sqlite:///D:/path/to/openchatbi/data/semantic_demo/demo.sqlite
